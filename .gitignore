# --------------------------------
# Image build secrets and outputs
# --------------------------------

# The cosign private key lives only in the SIGNING_SECRET repository secret.
cosign.key
cosign.private

# Generated by `bluebuild generate` and ISO builds.
/Containerfile
*.iso
*.iso-CHECKSUM

# Python regression-test bytecode.
__pycache__/

# ---------------------------------
# .gitignore for Linux environments
# ---------------------------------

*~

# temporary files which can be created if a process still has a handle open of a deleted file
.fuse_hidden*

# KDE directory preferences
.directory

# Linux trash folder which might appear on any partition or disk
.Trash-*

# .nfs files are created when an open file is removed but is still being accessed
.nfs*

# Log files created by default by the nohup command
nohup.out

# ---------------------------------
# .gitignore for macOS environments
# ---------------------------------

# General
.DS_Store
.localized
__MACOSX/
.AppleDouble
.LSOverride
# Custom folder icons are named "Icon" plus a carriage return. The brackets
# below hold a literal CR (invisible in most editors): "Icon?" would also
# ignore folders such as Icons/, and "Icon[\r]" matches "Iconr" instead.
Icon[]

# Thumbnails & Resource forks
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.com.apple.timemachine.supported
.PKInstallSandboxManager
.PKInstallSandboxManager-SystemSoftware
.hotfiles.btree
.vol
.file
.disk_label*
lost+found
.HFS+ Private Directory Data?

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# iCloud generated files
*.icloud

# Quota system
.quota.group
.quota.user
.quota.ops.group
.quota.ops.user

# TimeMachine
Backups.backupdb
.MobileBackups
.MobileBackups.trash
MobileBackups.trash
tmbootpicker.efi

# ------------------------------------
# .gitignore for Environment Variables
# ------------------------------------

.env
.env.*
!.env.example
!.env.sample

# -----------------------------
# .gitignore for JetBrains IDEs
# -----------------------------

# Covers IntelliJ IDEA, PyCharm, GoLand, WebStorm, Rider and the rest. Shared
# run configurations and code style can be committed by un-ignoring them, e.g.
# !.idea/runConfigurations/ and !.idea/codeStyles/. That only works because the
# rule below ignores what is inside .idea rather than the directory itself: git
# cannot re-include a file whose parent directory is excluded.
.idea/*
*.iml
*.ipr
*.iws

# ------------------------------------
# .gitignore for Agents and Assistants
# ------------------------------------

# Claude Code
CLAUDE.local.md
# .claude/
.claude/*.local.json
.claude/**/*.log
.claude/worktrees/

# ---------------------------
# .gitignore for Zed projects
# ---------------------------

.zed/*
!.zed/settings.json
!.zed/tasks.json
!.zed/debug.json

# ------------------------------------------
# .gitignore for Visual Studio Code projects
# ------------------------------------------

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

# Ionide (F#) workspace state
.ionide
