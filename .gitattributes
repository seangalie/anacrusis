# Normalize all text files to LF in the repository AND on checkout, so that
# every platform sees the same bytes. This matters for anything under files/:
# it is copied into the image as-is, and a build script with CRLF line endings
# fails inside the build.
*           text=auto eol=lf
*.sh        text eol=lf diff=bash
*.bash      text eol=lf diff=bash
*.py        text eol=lf diff=python
*.toml      text eol=lf
*.xml       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.md        text eol=lf diff=markdown
*.txt       text eol=lf
*.conf      text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.desktop   text eol=lf
*.pub       text eol=lf
*.svg       text eol=lf

# These files are text and should have LF line endings on checkout
.gitattributes  text eol=lf
.gitignore      text eol=lf
.gitmodules     text eol=lf
.editorconfig   text eol=lf

# Fix syntax highlighting on GitHub/Forgejo to allow comments
.vscode/*.json  linguist-language=JSON-with-Comments

# Images (wallpapers, logos, icons)
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.avif      binary
*.jxl       binary

# Archives and disk images
*.zip       binary
*.tar       binary
*.gz        binary
*.tgz       binary
*.xz        binary
*.zst       binary
*.iso       binary
*.rpm       binary

# Fonts
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary

# Text files where line endings should be preserved
*.patch -text
*.diff  -text
